name: ETL Preços Europa — CIRAD

# O relatório da CIRAD chega por e-mail (Microsoft 365) e não tem API — já
# perguntado ao fornecedor. Um flow do Power Automate deposita o PDF numa pasta
# do ownCloud e este job lê por WebDAV.
#
# Nenhuma credencial de e-mail entra aqui: o Actions só conhece o WebDAV.
#
# Roda todo dia útil de propósito. O relatório é semanal, mas o dia de chegada
# varia e às vezes atrasa. O upsert é idempotente na chave (ano, semana, grade),
# então reprocessar a mesma semana não duplica nem suja nada — só reescreve
# valores idênticos. Por padrão o ETL baixa os 5 PDFs mais recentes da pasta,
# não a pasta inteira.

on:
  schedule:
    # 13:30 UTC = 10:30 BRT, de segunda a sexta.
    - cron: '30 13 * * 1-5'
  workflow_dispatch:
    inputs:
      dry_run:
        description: 'Só mostrar o que faria, sem gravar no Supabase'
        type: boolean
        required: false
        default: false
      todos:
        description: 'Processar a pasta inteira (backfill do histórico)'
        type: boolean
        required: false
        default: false

concurrency:
  group: etl-europa-cirad
  cancel-in-progress: false

jobs:
  europa:
    name: Europa (CIRAD / FruiTrop)
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      issues: write
      contents: read

    env:
      SUPABASE_URL:     ${{ secrets.SUPABASE_URL }}
      SUPABASE_KEY:     ${{ secrets.SUPABASE_KEY }}
      OWNCLOUD_URL:     ${{ secrets.OWNCLOUD_URL }}
      OWNCLOUD_PASTA:   ${{ secrets.OWNCLOUD_PASTA }}
      OWNCLOUD_USER:    ${{ secrets.OWNCLOUD_USER }}
      OWNCLOUD_PASS:    ${{ secrets.OWNCLOUD_PASS }}
      PYTHONIOENCODING: utf-8
      PYTHONUNBUFFERED: '1'

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Instalar dependências
        run: pip install --upgrade pip && pip install -r requirements.txt

      - name: Conferir secrets
        run: |
          faltando=""
          for v in SUPABASE_URL SUPABASE_KEY OWNCLOUD_URL OWNCLOUD_PASTA OWNCLOUD_USER OWNCLOUD_PASS; do
            if [ -z "${!v}" ]; then faltando="$faltando $v"; fi
          done
          if [ -n "$faltando" ]; then
            echo "::error::secrets não configurados:$faltando"
            exit 1
          fi

      - name: ETL Europa CIRAD
        id: etl
        run: |
          args=""
          if [ "${{ inputs.dry_run }}" = "true" ]; then args="$args --dry-run"; fi
          if [ "${{ inputs.todos }}" = "true" ]; then args="$args --todos"; fi
          python etl_europa_cirad.py $args

      - name: Resumo
        if: always()
        run: |
          echo "### Europa (CIRAD / FruiTrop)" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "Resultado: \`${{ steps.etl.outcome }}\`" >> $GITHUB_STEP_SUMMARY

      - name: Abrir issue em caso de falha
        if: failure()
        uses: actions/github-script@v7
        with:
          script: |
            const titulo = `Falha ETL Europa CIRAD — ${new Date().toISOString().slice(0,16).replace('T',' ')} UTC`;
            const corpo = [
              '**ETL:** Europa CIRAD → Supabase `europa_cirad_precos` e `europa_cirad_calibre`',
              `**Run:** https://github.com/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}`,
              '',
              'Causas mais comuns, em ordem de probabilidade:',
              '1. O flow do Power Automate parou e não há PDF novo na pasta do ownCloud.',
              '2. Credencial do WebDAV expirada (senha de aplicativo revogada).',
              '3. A CIRAD mudou o layout do relatório. O ETL avisa qual etapa falhou:',
              '   "não achei AVOCADO REPORT WEEK", "tabela do preço não encontrada"',
              '   ou "página 4 sem a grade de calibres".',
              '4. Preço fora da faixa 3–40 €/caixa: a guarda de sanidade recusou a leitura.',
              '   Isso é erro de parsing, não de mercado — conferir o PDF na mão.',
              '',
              'Para reproduzir local com um PDF baixado à mão:',
              '`python etl_europa_cirad.py --arquivo "CIRAD avocado report Week NN-AAAA.pdf" --dry-run`',
            ].join('\n');
            await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: titulo,
              body: corpo,
              labels: ['etl-falha', 'precos'],
            });
